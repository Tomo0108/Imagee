{
  "name": "imagee",
  "version": "1.1.0",
  "private": true,
  "description": "Imagee — 端末の中だけで完結する画像エディタ",
  "author": "Imagee",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "package:mac": "npm run build && electron-builder --mac --dir --publish never",
    "package:mac:dmg": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "site": "npm run build && node scripts/build-site.mjs"
  },
  "build": {
    "appId": "app.imagee.editor",
    "productName": "Imagee",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "avif",
          "gif",
          "bmp"
        ],
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "psd"
        ],
        "name": "Photoshop Document",
        "role": "Editor"
      },
      {
        "ext": [
          "imagee"
        ],
        "name": "Imagee Project",
        "description": "Imagee プロジェクト",
        "role": "Owner",
        "mimeType": "application/x-imagee"
      }
    ],
    "mac": {
      "icon": "public/icons/Imagee.icns",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Imagee-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "public/icons/Imagee.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Imagee-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Imagee-win-setup.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "ag-psd": "^31.0.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
